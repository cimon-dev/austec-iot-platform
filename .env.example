# ==============================================================================
# AUSTEC IOT PLATFORM - MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Copy thành .env rồi điền IP Wi-Fi hoặc VPS, sau đó chạy .\scripts\sync-env.ps1
# ==============================================================================

SERVER_HOST=YOUR_WIFI_IP_OR_VPS_HOST
MEDIAMTX_HOST=YOUR_WIFI_IP_OR_VPS_HOST

BACKEND_PORT=4000
STREAM_SERVER_PORT_RTSP=8554
STREAM_SERVER_PORT_HLS=8888
STREAM_SERVER_PORT_WEBRTC=8889
STREAM_SERVER_PORT_ICE=8189

MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

LOCAL_BACKEND_URL=http://YOUR_WIFI_IP_OR_VPS_HOST:4000
CLOUD_BACKEND_URL=https://austec-backend.onrender.com

MEDIAMTX_AUTH_URL=http://host.docker.internal:4000/api/media/auth
MEDIAMTX_HOOK_BASE_URL=http://host.docker.internal:4000/api/media/hook

