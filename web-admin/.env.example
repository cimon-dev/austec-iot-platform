# ==============================================================================
# Austec IoT Web Admin - Environment Variables
# ==============================================================================

# Backend API URL (Render Cloud or Local)
# Khi dùng Backend trên Render:
NEXT_PUBLIC_API_URL=https://austec-backend.onrender.com

# Khi dùng Backend Local:
# NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket Realtime URL (Tự động chuyển https:// thành wss:// nếu không khai báo)
# NEXT_PUBLIC_WS_URL=wss://austec-backend.onrender.com/ws/chat
